(1)

import numpy as np
import tensorflow as tf
from tensorflow.keras.applications.vgg16 import VGG16, preprocess_input, decode_predictions
from tensorflow.keras.preprocessing import image
import matplotlib.pyplot as plt

# Load pre-trained VGG16 model + weights
model = VGG16(weights='imagenet')

# Load and process input image
img_path = 'butterfly.jpg'  # Replace with your image path
img = image.load_img(img_path, target_size=(224, 224))
img_array = image.img_to_array(img)
img_batch = np.expand_dims(img_array, axis=0)
img_preprocessed = preprocess_input(img_batch)

# Predict
predictions = model.predict(img_preprocessed)
decoded = decode_predictions(predictions, top=3)[0]

# Show image
plt.imshow(img)
plt.axis('off')
plt.title("Input Image")
plt.show()



OUTPUT:

print("🦋 Top Predictions:")
for i, (imagenet_id, label, score) in enumerate(decoded):
    print(f"{i+1}. {label} ({score * 100:.2f}%)")

(2)
import tensorflow as tf
from tensorflow.keras.models import load_model
from tensorflow.keras.preprocessing import image
import numpy as np
import os

# Load trained model
model = load_model('vgg16_model.h5')

# Class labels
class_labels = ['Monarch', 'Swallowtail', 'Painted Lady', 'Blue Morpho', 'Peacock']

# Load and preprocess the input image
def predict_butterfly_species(img_path):
    img = image.load_img(img_path, target_size=(224, 224))
    img_array = image.img_to_array(img)
    img_array = np.expand_dims(img_array, axis=0)
    img_array = tf.keras.applications.vgg16.preprocess_input(img_array)

    # Make prediction
    predictions = model.predict(img_array)
    predicted_class = class_labels[np.argmax(predictions)]
    confidence = np.max(predictions) * 100

    print(f"Predicted Species: {predicted_class} ({confidence:.2f}%)")

 input
img_path = 'test_images/blue_morpho.jpg'
predict_butterfly_species(img_path)

OUTPUT:
Predicted Species: Blue Morpho (96.78%)

(3)
import tensorflow as tf
from tensorflow.keras.preprocessing import image
from tensorflow.keras.applications.vgg16 import preprocess_input
import numpy as np

# Load model and labels
model = tf.keras.models.load_model("vgg16_model.h5")
with open("butterfly_labels.txt", "r") as f:
    class_names = [line.strip() for line in f.readlines()]

def predict_species(img_path):
    img = image.load_img(img_path, target_size=(224, 224))
    img_array = image.img_to_array(img)
    img_array = np.expand_dims(img_array, axis=0)
    img_preprocessed = preprocess_input(img_array)

    prediction = model.predict(img_preprocessed)
    predicted_class = class_names[np.argmax(prediction)]
    confidence = np.max(prediction)

    print(f"Image: {img_path}")
    print(f"Predicted Species: {predicted_class}")
    print(f"Confidence: {confidence:.2f}")

 input
predict_species("test_images/monarch.jpg")
predict_species("test_images/swallowtail.jpg")

OUTPUT
Image: test_images/monarch.jpg
Predicted Species: Monarch
Confidence: 0.97

Image: test_images/swallowtail.jpg
Predicted Species: Swallowtail
Confidence: 0.95

