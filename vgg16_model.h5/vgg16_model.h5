import tensorflow as tf
import numpy as np
from tensorflow.keras.preprocessing import image
import os

# Load model
model = tf.keras.models.load_model('butterfly_model.h5')

# Class indices (must match training order)
class_names = ['Danaus', 'Papilio', 'Pieris', 'Monarch', 'Swallowtail'] 

# Load and preprocess image
img_path = 'sample_butterfly.jpg'
img = image.load_img(img_path, target_size=(128, 128))
img_array = image.img_to_array(img) / 255.0
img_array = np.expand_dims(img_array, axis=0)

# Predict
pred = model.predict(img_array)
class_index = np.argmax(pred)
print("Predicted Butterfly Species:", class_names[class_index])

